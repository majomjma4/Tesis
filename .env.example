# Variables locales; configurar en Apache/PHP o en el entorno del servidor.
# Debe ser Base64 de exactamente 32 bytes. No incluir una clave real aquí.
APP_SETTINGS_ENCRYPTION_KEY=
APP_ENV=production
DEV_AUTORELOAD=false
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_me
DB_USERNAME=replace_me
DB_PASSWORD=
APP_URL=http://localhost/TESIS
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Gestion Documental Academica
