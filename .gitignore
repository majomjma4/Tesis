/storage/repository/*.zip
/storage/backups/
# Materiales de apoyo generados por usuarios: privados y específicos de cada
# instalación. Las excepciones siguientes son únicamente fixtures demostrativos
# referenciados por database/snapshot.sql.
/storage/support-materials/*
!/storage/support-materials/.gitkeep
!/storage/support-materials/README.md
!/storage/support-materials/guia_perfil_tesis.pdf
!/storage/support-materials/lista_de_verificacion_para_elaboracion_del_perfil_de_tesis.txt
!/storage/support-materials/material_tesis_completo.zip
!/storage/support-materials/seguimiento_practicas.docx
!/storage/support-materials/instructivo_proyectos_pis.pdf
!/storage/support-materials/informe_vinculacion.docx
!/storage/support-materials/reglamento_material_apoyo.txt
/storage/private/projects/*
/storage/private/project-previews/*
!/storage/private/project-previews/.gitkeep
/app/config/database.local.php
/app/config/app.local.php
# Variables de entorno locales con secretos
/.env
/.env.*
!/.env.example
/database/snapshot.before-portability.local.sql
/dist/
storage/private/avatars/*
!storage/private/avatars/.gitkeep
/storage/private/project-review-representations/*
!/storage/private/project-review-representations/.gitkeep
# Runtime privado adicional: nunca versionar cargas, paquetes ni temporales.
/storage/private/project-packages/*
!/storage/private/project-packages/.gitkeep
/storage/private/project-drafts/*
!/storage/private/project-drafts/.gitkeep
/storage/private/project-publication-preparations/*
!/storage/private/project-publication-preparations/.gitkeep
/storage/repository/*
!/storage/repository/.gitkeep
/storage/calendar/*
!/storage/calendar/.gitkeep
# Backups, recovery y QA contienen datos o evidencias de instalaciones reales.
/database/backups/
/database/recovery/
/database/backup_*.sql
/storage/qa-backups/
/storage/qa-fixtures/
# Dependencias y herramientas locales; el build cPanel las incorpora desde composer.lock.
/vendor/
/composer.phar
scratch_*
