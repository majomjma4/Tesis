# Mantiene finales de linea consistentes en archivos de texto.
* text=auto eol=lf

# Reglas explicitas para archivos de codigo.
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.gitattributes text eol=lf

# Los binarios no deben normalizarse como texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
